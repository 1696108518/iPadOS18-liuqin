+static void
+tu_liuqin_sync_tag(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint64_t addr, uint32_t tag)
+{
+   if (!tag || !tu_liuqin_sync_enabled())
+      return;
+
+   tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 4);
+   tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = CACHE_CLEAN,
+                                    .write_src = EV_WRITE_USER_32B,
+                                    .write_dst = EV_DST_RAM,
+                                    .write_enabled = true).value);
+   tu_cs_emit_qw(cs, addr);
+   tu_cs_emit(cs, tag);
+
